[package]
name = "{{crate_name}}"
version = "0.0.1"
edition = "2024"
description = "{{crate_description}}"
authors = ["Akshay Kumar (akskum95@gmail.com)"]
{% if repository -%}
repository = "{{repository}}"
{% endif -%}
license = "MIT OR Apache-2.0"

[dependencies]
{% if project_kind == "webapp" -%}
axum = "0.8"
tokio = { version = "1", features = ["macros", "net", "rt-multi-thread"] }
{% endif %}

[dev-dependencies]

[lints.clippy]
pedantic = { level = "warn", priority = -100 }

[lints.rust]
unsafe_code = "forbid"
